# =============================================================================
# BLEU MANAGER — ENVIRONNEMENT DE TEST AVEC VERCEL BLOB
# =============================================================================

# Chemin de l'objet JSON utilisé comme base de test dans le Blob privé.
# Il n'est normalement pas nécessaire de le modifier.
BLOB_DB_PATH=bleu-manager/test-db.json

# Sur Vercel, connecter un Blob Store PRIVATE au projet depuis Storage.
# Les nouveaux stores utilisent OIDC : aucun BLOB_READ_WRITE_TOKEN statique
# n'est requis dans le déploiement Vercel.
#
# Pour le développement local, utiliser `vercel link` puis `vercel env pull`
# afin de récupérer les identifiants nécessaires au SDK Blob.

# Administrateur initial : créé automatiquement si aucun ADMIN n'existe encore.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
BOOTSTRAP_ADMIN_NAME=Administrateur

# Secret envoyé par le Google Apps Script au webhook Google Forms.
GOOGLE_FORMS_WEBHOOK_SECRET=change-me

# Durée d'une session, en jours.
SESSION_TTL_DAYS=7
