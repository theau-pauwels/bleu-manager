# MariaDB / MySQL
DATABASE_URL=mysql://bleumanager:change-me@127.0.0.1:3306/bleumanager

# Admin initial : créé automatiquement si aucun administrateur n'existe.
# Ne jamais committer les vraies valeurs.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-immediately
BOOTSTRAP_ADMIN_NAME=Administrateur

# Secret envoyé par le Google Apps Script au webhook.
GOOGLE_FORMS_WEBHOOK_SECRET=change-me

# Durée d'une session, en jours.
SESSION_TTL_DAYS=7
