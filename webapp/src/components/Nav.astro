<header class="sticky top-0 z-30 border-b border-slate-200 bg-white/95 backdrop-blur">
  <nav class="container mx-auto flex h-16 items-center justify-between px-4">
    <a href="/" class="flex items-center gap-3 font-bold text-slate-900">
      <span class="grid h-9 w-9 place-items-center rounded-xl bg-redcross-500 text-xl text-white">+</span>
      <span>Bleu Manager</span>
    </a>
    <div class="hidden items-center gap-5 text-sm font-semibold md:flex">
      <a href="/bleus" class="hover:text-redcross-500">Bleus</a>
      <a href="/api/export.xlsx" class="hover:text-redcross-500">Exporter Excel</a>
      <a id="admin-link" href="/admin/users" class="hidden hover:text-redcross-500">Utilisateurs</a>
      <button id="logout" class="hover:text-redcross-500">Déconnexion</button>
    </div>
    <div id="identity" class="text-right text-xs text-slate-500"></div>
  </nav>
</header>

<nav class="fixed inset-x-0 bottom-0 z-30 grid grid-cols-4 border-t border-slate-200 bg-white p-2 pb-[max(.5rem,env(safe-area-inset-bottom))] md:hidden">
  <a href="/" class="rounded-xl p-2 text-center text-xs font-semibold">Accueil</a>
  <a href="/bleus" class="rounded-xl p-2 text-center text-xs font-semibold">Bleus</a>
  <a href="/api/export.xlsx" class="rounded-xl p-2 text-center text-xs font-semibold">Excel</a>
  <button id="logout-mobile" class="rounded-xl p-2 text-center text-xs font-semibold">Quitter</button>
</nav>

<script>
  const logout = async () => {
    await fetch('/api/auth/logout', { method: 'POST' });
    location.href = '/login';
  };
  document.getElementById('logout')?.addEventListener('click', logout);
  document.getElementById('logout-mobile')?.addEventListener('click', logout);

  fetch('/api/me').then(async (r) => {
    if (!r.ok) {
      location.href = '/login?next=' + encodeURIComponent(location.pathname);
      return;
    }
    const me = await r.json();
    const identity = document.getElementById('identity');
    if (identity) identity.textContent = `${me.displayName} · ${me.role === 'ADMIN' ? 'Administrateur' : 'Chef flics'}`;
    if (me.role === 'ADMIN') document.getElementById('admin-link')?.classList.remove('hidden');
  });
</script>
